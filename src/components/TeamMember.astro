---
import Image from '~/components/common/Image.astro';
export interface Props {
  name: string;
  role: string;
  image: string;
  href?: string;
}
const { name, role, image, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href || undefined} class="flex items-center">
  <Image src={image} class="object-cover w-20 h-20 mr-4 rounded-full shadow" alt={name} width={160} height={160} loading="lazy" />
  <div class="relative">
    <p class="text-lg font-bold">{name}</p>
    <p class="text-sm text-muted">{role}</p>
  </div>
</Tag>
