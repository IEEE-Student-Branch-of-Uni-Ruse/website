---
import timeline from '~/data/timeline.json';
const { bg = false } = Astro.props;
const translated = [
 ['ноември 2025 г.', 'Лекция по микро- и наноелектроника', 'Проф. Рикардо Рейс беше поканен да изнесе лекция в Русенския университет.'],
 ['юни 2024 г.', 'Иновативна седмица на технологиите', 'Програмата включваше Електрониада и първа балканска среща на студентски клонове на IEEE и EPS.'],
 ['юни 2024 г.', 'Международна Електрониада', 'В международното издание участваха 13 отбора от България и Румъния.'],
 ['май 2023 г.', 'Признание за студентски уебсайт', 'Член на клона спечели второ място в университетския конкурс.'],
 ['февруари 2023 г.', 'Начало на нашия сайт', 'Студентският клон представи своя уебсайт.'],
 ['септември 2022 г.', 'Среща на студентски клонове в Сибиу', 'Представители от България, Румъния и Унгария се срещнаха по време на конференция по електроника.'],
 ['март 2022 г.', 'Международна студентска секция на Електрониада', 'Студентският клон на EPS беше съорганизатор на секцията.'],
 ['януари 2022 г.', 'Откриване на клона', 'Студентският клон отвори врати в Русенския университет.']
];
---
<ol class="relative border-l-2 border-blue-100 dark:border-slate-700 ml-3 space-y-5">
  {timeline.items.map((item, index) => <li class="relative pl-8 md:pl-12"><span aria-hidden="true" class="absolute -left-[9px] top-9 h-4 w-4 rounded-full border-4 border-white dark:border-slate-900 bg-primary"></span><article class="rounded-3xl bg-blue-50 dark:bg-slate-800 p-7 md:p-9"><p class="text-sm font-bold uppercase tracking-wider text-primary">{bg ? translated[index][0] : item.date}</p><h2 class="mt-3 text-xl md:text-2xl font-bold text-heading">{bg ? translated[index][1] : item.title}</h2><p class="mt-3 leading-relaxed text-muted max-w-2xl">{bg ? translated[index][2] : item.description}</p>{item.href && <a href={bg ? `/bg${item.href}` : item.href} class="inline-block mt-5 font-semibold text-primary hover:underline underline-offset-4">{bg ? 'Научи повече' : timeline.linkLabel} →</a>}</article></li>)}
</ol>
