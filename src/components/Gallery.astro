---
import gallery from '~/data/gallery.json';
const { bg = false } = Astro.props;
---
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {gallery.map((item) => <article class="rounded-2xl overflow-hidden border border-blue-100 dark:border-slate-700 bg-white dark:bg-slate-900"><a href={item.src} target="_blank" rel="noopener" aria-label={`${bg ? 'Отвори изображение' : 'Open image'}: ${bg ? item.titleBg : item.title}`}><img src={item.src} alt={item.alt} class="w-full aspect-[4/3] object-cover" loading="lazy" /></a><div class="p-5"><p class="text-sm text-muted">{bg ? item.dateBg : item.date}</p><h2 class="font-bold text-xl mt-2">{bg ? item.titleBg : item.title}</h2><a href={item.href} class="inline-block mt-3 text-primary font-semibold">{bg ? 'Новина на английски' : 'Read the story'} →</a></div></article>)}
</div>
