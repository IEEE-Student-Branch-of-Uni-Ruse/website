---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';
import { postTopic } from '~/utils/topics';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<ul id="news-items">
  {posts.map((post, index) => (
    <li data-filter-item data-year={String(post.publishDate.getUTCFullYear())} data-topic={postTopic(post.slug)} class="mb-12 md:mb-20">
      <Item post={post} eager={index < 3} />
    </li>
  ))}
</ul>
