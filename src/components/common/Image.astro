---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { findImage } from '~/utils/images';

type Layout = 'constrained' | 'full-width' | 'fixed' | 'cover' | 'none';
type Format = 'avif' | 'jpeg' | 'jpg' | 'png' | 'webp';
interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> {
  src?: string | ImageMetadata | null;
  width?: number | string;
  height?: number | string;
  widths?: number[];
  format?: Format;
  layout?: Layout;
}
const { src, alt, width, height, widths, format, layout = 'constrained', ...rest } = Astro.props;
if (alt === undefined || alt === null) throw new Error(`Image requires alt text: ${String(src)}`);
const image = await findImage(src);
const w = width === undefined ? undefined : Number(width);
const h = height === undefined ? undefined : Number(height);
const style = [layout === 'cover' ? 'object-fit:cover;width:100%;height:100%' : undefined, rest.style].filter(Boolean).join(';') || undefined;
const imageProps = { ...rest, alt, width: w, height: h, style };
---
{typeof image === 'string' ? (
  <img src={image} {...imageProps} />
) : image ? (
  <Picture
    src={image}
    {...imageProps}
    widths={widths}
    formats={['avif', 'webp']}
    fallbackFormat={format || 'webp'}
    layout={layout === 'cover' ? 'none' : layout}
  />
) : null}
