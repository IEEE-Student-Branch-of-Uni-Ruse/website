---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Filters from '~/components/Filters.astro';
import { fetchPosts } from '~/utils/blog';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const allPosts = currentPage === 1 ? await fetchPosts() : page.data;
const years = [...new Set(allPosts.map((post) => String(post.publishDate.getUTCFullYear())))].sort().reverse();

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  ...(currentPage > 1
    ? [{ text: 'Blog', href: getBlogPermalink() }, { text: `Page ${currentPage}` }]
    : [{ text: 'Blog' }]),
];

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description: 'News and activities from the IEEE Student Branch of University of Ruse.',
  robots: {
    index: blogListRobots?.index,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'website',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {currentPage > 1 && page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle="News, projects and activities from our student branch.">The Blog</Headline>
    <Filters {years} id="news-items" />
    <BlogList posts={allPosts} />
    {currentPage > 1 && <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />}
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
  </section>
</Layout>
