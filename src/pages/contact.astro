---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import site from '~/data/site.json';
import { getPermalink } from '~/utils/permalinks';

const { contact } = site;
const metadata = { title: contact.tagline, description: contact.description };
---

<Layout metadata={metadata}>
  <HeroText
    tagline={contact.tagline}
    title={contact.title}
    subtitle={contact.description}
    callToAction={{ text: contact.faqText, href: getPermalink('/about/faq') }}
  />
  <Features2
    title={contact.channelsTitle}
    columns={2}
    items={contact.channels.map(({ href, linkText, ...channel }) => ({
      ...channel,
      callToAction: { text: linkText, href },
    }))}
  />
</Layout>
