---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import home from '~/data/home.json';

const metadata = { title: home.title, ignoreTitleTemplate: true };
---

<Layout metadata={metadata}>
  <Hero image={{ ...home.hero, aspect: "auto" }}>
    <Fragment slot="title">{home.title}</Fragment>
  </Hero>
  <Note {...home.mission} />
  <Features title={home.benefitsTitle} items={home.benefits} />
  <section class="max-w-6xl mx-auto px-6 py-12">
    <a href="/bip-big-data-and-ai-for-res" class="block rounded-2xl border border-primary/30 bg-primary/5 p-8">
      <p class="text-primary font-semibold">Erasmus+ · BIP</p>
      <h2 class="text-2xl md:text-3xl font-bold mt-3">Big Data and AI for the Digitalization of Renewable Energy Systems</h2>
      <p class="mt-4">University of Ruse · Online: 30 March–3 April 2026 · Onsite: 6–10 April 2026</p>
      <span class="inline-block mt-4 font-semibold text-primary">Programme details →</span>
    </a>
  </section>
  <BlogLatestPosts title={home.blogTitle} />
  <Stats stats={home.stats} />
</Layout>
