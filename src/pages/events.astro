---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { Picture } from 'astro:assets';
import communityImage from '~/assets/images/site/home-community.png';
import renewableImage from '~/assets/images/public/live/benjamin-jopen-2SfssudtyIA-unsplash-scaled.jpg';
import events from '~/data/events.json';
const bg = Astro.currentLocale === 'bg';
const t = (en: string, bgText: string) => bg ? bgText : en;
const descriptions = ['Покажи компютърните си умения.', 'Международен хакатон, в който студенти, учени и предприемачи работят заедно по реални проблеми, свързани с Космоса и Земята.'];
---

<Layout metadata={{ title: t(events.title, 'Събития'), description: t('Explore activities and programmes from the IEEE Student Branch of the University of Ruse.', 'Разгледай дейностите и програмите на студентския клон на IEEE към Русенския университет.') }}>
  <section class="max-w-7xl mx-auto px-6 pt-14 pb-16 md:pt-24 md:pb-24">
    <div class="grid lg:grid-cols-[1fr_0.9fr] gap-12 lg:gap-20 items-center">
      <div>
        <p class="text-xs font-bold tracking-[.18em] text-primary uppercase mb-6">{t('Meet · Learn · Create', 'Срещай се · Учи · Създавай')}</p>
        <h1 class="text-5xl sm:text-6xl xl:text-7xl font-bold tracking-tight leading-[1.04] text-heading">{t('Ideas are better', 'Идеите са по-добри')}<br /><span class="text-primary">{t('together.', 'заедно.')}</span></h1>
        <p class="mt-7 text-lg sm:text-xl leading-relaxed text-muted max-w-xl">{t('Discover opportunities to connect, explore technology and share ideas with our community at the University of Ruse.', 'Открий възможности да се свързваш с хора, да изследваш технологиите и да споделяш идеи с нашата общност в Русенския университет.')}</p>
        <div class="flex flex-wrap gap-3 mt-9">
          <a href="#activities" class="rounded-full bg-primary px-7 py-4 font-semibold text-white hover:bg-secondary transition">{t('Explore activities', 'Разгледай дейностите')} <span aria-hidden="true">↓</span></a>
          <a href={bg ? '/bg/contact' : '/contact'} class="rounded-full border border-current px-7 py-4 font-semibold hover:text-primary transition">{t('Get in touch', 'Свържи се с нас')} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="relative">
        <div class="absolute -inset-3 bg-blue-100 dark:bg-blue-950 rounded-[2.5rem] -rotate-2" aria-hidden="true"></div>
        <Picture src={communityImage} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1536]} sizes="(max-width: 1023px) 100vw, 50vw" loading="eager" fetchpriority="high" alt={t('Illustration of students collaborating on a technology project', 'Илюстрация на студенти, които работят заедно по технологичен проект')} width="1536" height="1024" class="relative w-full aspect-[4/3] object-cover rounded-[2rem]" />
        <div class="absolute -bottom-5 left-5 sm:left-8 rounded-2xl bg-white dark:bg-slate-900 px-5 py-3 shadow-lg text-sm font-semibold">{t('Curiosity brings us together', 'Любопитството ни събира')} <span aria-hidden="true">✦</span></div>
      </div>
    </div>
  </section>

  <section id="activities" class="max-w-7xl mx-auto px-6 py-16 md:py-24 scroll-mt-24">
    <div class="flex flex-wrap justify-between gap-5 items-end">
      <div><p class="text-primary text-sm font-bold uppercase tracking-widest">{t('Explore together', 'Откривай заедно с нас')}</p><h2 class="mt-4 text-3xl md:text-5xl font-bold tracking-tight text-heading">{t('Find something that sparks an idea.', 'Открий какво запалва идеите ти.')}</h2></div>
      <p class="text-muted max-w-md leading-relaxed">{t('Our activities are still being planned. Dates will be shared when confirmed.', 'Дейностите все още се планират. Ще обявим датите, когато бъдат потвърдени.')}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-5 mt-10">
      {events.items.map((event, index) => (
        <article class:list={['rounded-[2rem] p-8 md:p-10 min-h-72 flex flex-col', index % 2 === 0 ? 'bg-blue-50 dark:bg-slate-800' : 'bg-indigo-50 dark:bg-slate-800']}>
          <div class="flex items-start justify-between gap-4"><span class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white dark:bg-slate-900 text-primary"><Icon name={event.icon} class="w-7 h-7" /></span><span class="rounded-full border border-primary/20 px-3 py-1 text-xs font-semibold text-primary uppercase tracking-wide">{event.date.toLowerCase() === 'tbd' ? t('Date to be announced', 'Датата предстои да бъде обявена') : `${events.dateLabel} ${event.date}`}</span></div>
          <h3 class="mt-8 text-2xl font-bold text-heading">{bg && index === 0 ? 'Вечер на игрите' : event.title}</h3>
          <p class="mt-3 text-muted leading-relaxed max-w-lg">{bg ? descriptions[index] : event.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-16 md:pb-24">
    <div class="rounded-[2rem] bg-[#092b50] text-white overflow-hidden grid md:grid-cols-2">
      <Picture src={renewableImage} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 960, 1600]} sizes="(max-width: 767px) 100vw, 50vw" alt={t('Renewable energy landscape', 'Пейзаж с възобновяеми енергийни източници')} class="w-full h-64 md:h-full object-cover" loading="lazy" />
      <div class="p-8 md:p-12 lg:p-16"><p class="text-blue-200 text-sm font-bold tracking-widest uppercase">{t('Featured programme · 2026', 'Избрана програма · 2026')}</p><h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-5">{t('Big data, AI and renewable energy.', 'Големи данни, изкуствен интелект и възобновяема енергия.')}</h2><p class="mt-5 text-blue-100 leading-relaxed">{t('Explore the Erasmus+ blended intensive programme hosted by the University of Ruse, with online and onsite activities held in March and April 2026.', 'Разгледай смесената интензивна програма „Еразъм+“ на Русенския университет, провела се онлайн и присъствено през март и април 2026 г.')}</p><a class="inline-block mt-8 font-semibold text-white underline underline-offset-8" href={bg ? '/bg/bip-big-data-and-ai-for-res' : '/bip-big-data-and-ai-for-res'}>{t('Explore the programme →', 'Разгледай програмата →')}</a></div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-24"><div class="rounded-3xl bg-blue-50 dark:bg-slate-800 px-8 py-12 md:p-16 flex flex-wrap items-center justify-between gap-8"><div><p class="text-sm uppercase tracking-widest text-primary font-bold">{t('Stay connected', 'Остани във връзка')}</p><h2 class="mt-3 text-3xl md:text-4xl font-bold text-heading">{t('Have an idea for an activity?', 'Имаш идея за събитие?')}</h2><p class="mt-4 text-muted max-w-xl">{t("Questions, collaborations or something you'd love to explore together? Find us through our community channels.", 'Въпроси, сътрудничество или идея, която искаш да обсъдим? Намери ни в каналите на общността.')}</p></div><a href={bg ? '/bg/contact' : '/contact'} class="rounded-full bg-primary px-7 py-4 text-white font-semibold hover:bg-secondary transition">{t('Find our community →', 'Открий общността →')}</a></div></section>
</Layout>
