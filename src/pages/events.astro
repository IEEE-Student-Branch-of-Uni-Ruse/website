---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import events from '~/data/events.json';
---

<Layout metadata={{ title: events.title }}>
  <section class="relative w-full py-12 overflow-hidden md:py-20 xl:pt-32 xl:pb-40">
    <div class="container relative flex flex-col justify-between h-full max-w-6xl px-10 mx-auto xl:px-0">
      <h1 class="mb-1 text-3xl font-extrabold leading-tight">{events.title}</h1>
      <p class="mb-12 text-lg text-muted">{events.subtitle}</p>
      <div class="flex w-full h-full gap-10">
        <div class="w-full lg:w-2/3">
          {events.items.map((event, index) => (
            <div class="relative mb-10 sm:mr-10">
              <span class:list={['absolute inset-0 mt-1 ml-1 rounded-lg', index % 2 ? 'bg-blue-400' : 'bg-indigo-500']} />
              <article class:list={['relative h-full p-5 bg-page border-2 rounded-lg', index % 2 ? 'border-blue-400' : 'border-indigo-500']}>
                <div class="flex items-center -mt-1">
                  <Icon name={event.icon} class:list={['w-8 h-8', index % 2 ? 'text-blue-400' : 'text-indigo-500']} />
                  <h2 class="my-2 ml-3 text-lg font-bold">{event.title}</h2>
                </div>
                <p class:list={['mt-3 mb-1 text-xs font-medium uppercase', index % 2 ? 'text-blue-400' : 'text-indigo-500']}>{events.dateLabel} {event.date}</p>
                <p class="mb-2 text-muted">{event.description}</p>
              </article>
            </div>
          ))}
        </div>
        <div class="hidden w-1/3 lg:block">
          <img src={events.image.src} alt={events.image.alt} class="object-cover w-full rounded-2xl border-2 border-black" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Layout>
