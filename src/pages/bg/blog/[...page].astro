---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Filters from '~/components/Filters.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { fetchPosts, blogPostsPerPage } from '~/utils/blog';
import translations from '~/data/posts-bg.json';
export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await fetchPosts()).filter((post) => post.slug in translations).map((post) => {
    const translation = translations[post.slug as keyof typeof translations];
    return { ...post, title: translation.title, excerpt: translation.excerpt, permalink: `bg/${post.slug}` };
  });
  return paginate(posts, { pageSize: blogPostsPerPage });
}) satisfies GetStaticPaths;
const { page } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const currentPage = page.currentPage ?? 1;
const allPosts = currentPage === 1 ? (await fetchPosts()).filter((post) => post.slug in translations).map((post) => { const translated = translations[post.slug as keyof typeof translations]; return { ...post, title: translated.title, excerpt: translated.excerpt, permalink: `bg/${post.slug}` }; }) : page.data;
const years = [...new Set(allPosts.map((post) => String(post.publishDate.getUTCFullYear())))].sort().reverse();
const breadcrumbs = [{ text: 'Начало', href: '/bg' }, ...(currentPage > 1 ? [{ text: 'Новини', href: '/bg/blog' }, { text: `Страница ${currentPage}` }] : [{ text: 'Новини' }])];
---
<Layout metadata={{ title: `Новини${currentPage > 1 ? ` — Страница ${currentPage}` : ''}`, description: 'Новини, проекти и инициативи на студентския клон на IEEE към Русенския университет.' }}>
  <Fragment slot="head">{page.url.prev && <link rel="prev" href={page.url.prev} />}{currentPage > 1 && page.url.next && <link rel="next" href={page.url.next} />}</Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle="Новини, проекти и инициативи на студентския клон.">Новини</Headline>
    <Filters {years} id="news-items" />
    <BlogList posts={allPosts} />
    {currentPage > 1 && <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} prevText="По-нови публикации" nextText="По-стари публикации" />}
  </section>
</Layout>
