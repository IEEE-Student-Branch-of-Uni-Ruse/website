---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import site from '~/data/site.json';
import { getPermalink } from '~/utils/permalinks';

const { about } = site;
const metadata = { title: about.title, description: about.description };
---

<Layout metadata={metadata}>
  <HeroText title={about.title} tagline={about.subtitle} subtitle={about.description} />
  <Features2
    title={about.sectionsTitle}
    columns={2}
    items={about.sections.map(({ href, linkText, ...section }) => ({
      ...section,
      callToAction: { text: linkText, href: getPermalink(href) },
    }))}
  />
</Layout>
