---
import Layout from '~/layouts/PageLayout.astro';
import timeline from '~/data/timeline.json';
---

<Layout metadata={{ title: timeline.title }}>
  <section class="container mx-auto p-8 md:p-16 max-w-6xl">
    <h1 class="text-3xl font-bold mb-10">{timeline.title}</h1>
    <ol class="relative border-l border-gray-200 dark:border-gray-700">
      {timeline.items.map((item) => (
        <li class="mb-10 ml-4 last:mb-0">
          <div class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -left-1.5 border border-white dark:border-gray-900 dark:bg-gray-700" />
          <span class="mb-1 text-sm font-normal leading-none">{item.date}</span>
          <h2 class="text-lg font-semibold">{item.title}</h2>
          <p class="text-base font-normal">{item.description}</p>
          {item.href && <a href={item.href} class="btn btn-secondary mt-3">{timeline.linkLabel} →</a>}
        </li>
      ))}
    </ol>
  </section>
</Layout>
