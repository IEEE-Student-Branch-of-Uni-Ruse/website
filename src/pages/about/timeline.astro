---
import Layout from '~/layouts/PageLayout.astro';
import TimelineList from '~/components/TimelineList.astro';
const bg = Astro.currentLocale === 'bg';
const t = (en: string, value: string) => bg ? value : en;
---
<Layout metadata={{ title: t('History', 'История'), description: t('Explore the history and milestones of the IEEE Student Branch at the University of Ruse.', 'Разгледай историята на студентския клон на IEEE към Русенския университет.') }}>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-24 md:pt-24"><div class="max-w-3xl mb-12 md:mb-16"><p class="text-primary text-sm font-bold uppercase tracking-widest">{t('Our journey', 'Нашият път')}</p><h1 class="mt-5 text-5xl md:text-6xl font-bold tracking-tight text-heading">{t('A history of ideas in motion.', 'История на идеи в движение.')}</h1><p class="mt-6 text-xl leading-relaxed text-muted">{t('From our first steps to the events and people that shaped our community, explore the milestones along the way.', 'От първите стъпки до събитията и хората, които изградиха нашата общност — разгледай важните моменти по пътя.')}</p></div><TimelineList {bg} /></section>
</Layout>
