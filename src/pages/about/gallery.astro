---
import Layout from '~/layouts/PageLayout.astro';
import Gallery from '~/components/Gallery.astro';
const bg = Astro.currentLocale === 'bg';
const t = (en: string, value: string) => bg ? value : en;
---
<Layout metadata={{ title: t('Gallery', 'Галерия'), description: t('Photographs and programme materials from IEEE Student Branch activities at the University of Ruse.', 'Снимки и материали от дейностите на студентския клон на IEEE към Русенския университет.') }}>
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-24"><p class="text-primary text-sm font-bold uppercase tracking-widest">{t('Our community', 'Нашата общност')}</p><h1 class="text-4xl md:text-6xl font-bold tracking-tight text-heading mt-5">{t('Moments and milestones.', 'Моменти и постижения.')}</h1><p class="text-lg text-muted mt-5 mb-12 max-w-2xl">{t('A selection of photographs and programme materials from our activities and the IEEE community.', 'Подбор от снимки и материали от дейностите на нашата IEEE общност.')}</p><Gallery {bg} /></section>
</Layout>
