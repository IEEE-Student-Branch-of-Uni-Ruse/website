---
import Layout from '~/layouts/PageLayout.astro';
import Gallery from '~/components/Gallery.astro';
---
<Layout metadata={{ title: 'Gallery', description: 'Photographs and programme materials from IEEE Student Branch activities at the University of Ruse.' }}>
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-24"><p class="text-primary text-sm font-bold uppercase tracking-widest">Our community</p><h1 class="text-4xl md:text-6xl font-bold tracking-tight text-heading mt-5">Moments and milestones.</h1><p class="text-lg text-muted mt-5 mb-12 max-w-2xl">A selection of photographs and programme materials from our activities and the IEEE community.</p><Gallery /></section>
</Layout>
