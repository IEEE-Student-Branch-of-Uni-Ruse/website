---
import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import faq from '~/data/faq.json';
---

<Layout metadata={{ title: faq.title, description: "Find answers about IEEE Student Branch membership, activities and volunteering at the University of Ruse." }}>
  <FAQs
    title={faq.heading}
    subtitle={faq.subtitle}
    tagline={faq.tagline}
    classes={{ container: 'max-w-6xl' }}
    items={faq.items}
  />
</Layout>
