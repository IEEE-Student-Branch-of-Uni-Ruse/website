---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import SearchDialog from '~/components/SearchDialog.astro';

import { headerData, footerData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
const bgLinks = [
  { text: 'Начало', href: '/bg' },
  { text: 'За нас', links: [{ text: 'За клона', href: '/bg/about' }, { text: 'Екип', href: '/bg/about/team' }, { text: 'История', href: '/bg/about/timeline' }, { text: 'Галерия', href: '/bg/about/gallery' }, { text: 'Въпроси', href: '/bg/about/faq' }] },
  { text: 'Общества', links: [{ text: 'Компютърно общество', href: '/bg/chapters/computer-society' }, { text: 'Електронно пакетиране', href: '/bg/chapters/electronics-packaging-society' }] },
  { text: 'BIP', href: '/bg/bip-big-data-and-ai-for-res' }, { text: 'Събития', href: '/bg/events' }, { text: 'Новини', href: '/bg/blog' }, { text: 'Контакти', href: '/bg/contact' },
];
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  {/*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */}
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:z-[100] focus:top-2 focus:left-2 focus:bg-white focus:text-black focus:px-4 focus:py-3 focus:rounded">{Astro.currentLocale === 'bg' ? 'Към основното съдържание' : 'Skip to main content'}</a>
  <slot name="announcement" />
  {Astro.slots.has('header') ? <slot name="header" /> : <Header links={Astro.currentLocale === 'bg' ? bgLinks : headerData.links} isSticky showRssFeed showToggleTheme />}
  <SearchDialog />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...footerData} />}
</Layout>
