---
import Layout from '~/layouts/PageLayout.astro';
export interface Props { frontmatter: { title: string; subtitle: string; theme: string; }; }
const { frontmatter } = Astro.props;
const computing = frontmatter.theme === 'computing';
---
<Layout metadata={{ title: frontmatter.title, description: frontmatter.subtitle }}>
  <section class="max-w-7xl mx-auto px-6 pt-14 pb-16 md:pt-24 md:pb-24">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <a href="/about" class="text-sm font-semibold text-primary hover:underline">← Our community</a>
        <p class="text-xs font-bold tracking-[.18em] text-primary uppercase mt-8 mb-5">IEEE · Explore your interests</p>
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight leading-[1.06] text-heading">{frontmatter.title}</h1>
        <p class="mt-7 text-lg sm:text-xl leading-relaxed text-muted max-w-xl">{frontmatter.subtitle}</p>
        <div class="flex flex-wrap gap-3 mt-9"><a href="#explore" class="rounded-full bg-primary px-7 py-4 font-semibold text-white hover:bg-secondary transition">Explore the field ↓</a><a href="/contact" class="rounded-full border border-current px-7 py-4 font-semibold hover:text-primary transition">Connect with us ↗</a></div>
      </div>
      <figure class="technical-figure">
        {computing ? (
          <svg viewBox="0 0 560 370" role="img" aria-labelledby="diagram-title diagram-desc">
            <title id="diagram-title">A simplified computer system</title><desc id="diagram-desc">Processor connected to memory and input and output devices through a system bus.</desc>
            <text x="36" y="42" class="diagram-kicker">COMPUTER SYSTEMS / CONCEPTUAL DIAGRAM</text>
            <rect x="42" y="94" width="135" height="75" rx="3"/><text x="109" y="127" text-anchor="middle" class="diagram-label">PROCESSOR</text><text x="109" y="149" text-anchor="middle" class="diagram-small">compute &amp; control</text>
            <rect x="215" y="94" width="130" height="75" rx="3"/><text x="280" y="127" text-anchor="middle" class="diagram-label">MEMORY</text><text x="280" y="149" text-anchor="middle" class="diagram-small">data &amp; instructions</text>
            <rect x="383" y="94" width="135" height="75" rx="3"/><text x="450" y="127" text-anchor="middle" class="diagram-label">STORAGE</text><text x="450" y="149" text-anchor="middle" class="diagram-small">persistent data</text>
            <path d="M109 169v62 M280 169v62 M450 169v62 M109 231h341 M280 231v48"/><circle cx="109" cy="231" r="4"/><circle cx="280" cy="231" r="4"/><circle cx="450" cy="231" r="4"/>
            <rect x="190" y="279" width="180" height="55" rx="3"/><text x="280" y="312" text-anchor="middle" class="diagram-label">INPUT / OUTPUT</text><text x="38" y="258" class="diagram-small">SYSTEM BUS</text>
          </svg>
        ) : (
          <svg viewBox="0 0 560 370" role="img" aria-labelledby="diagram-title diagram-desc">
            <title id="diagram-title">A simplified electronic package cross-section</title><desc id="diagram-desc">A semiconductor die connected to a package substrate and a printed circuit board, with heat flowing upward.</desc>
            <text x="36" y="42" class="diagram-kicker">ELECTRONICS PACKAGING / CROSS-SECTION</text>
            <path d="M183 258h194v-22H183z" class="layer-board"/><path d="M214 227h132v-20H214z" class="layer-substrate"/><path d="M246 191h68v-20h-68z" class="layer-die"/>
            <path d="M225 227v9 M245 227v9 M265 227v9 M285 227v9 M305 227v9 M325 227v9 M253 191v16 M268 191v16 M283 191v16 M298 191v16"/>
            <path d="M280 165V92 M272 103l8-11 8 11 M314 181h62 M346 217h30 M377 247h35"/>
            <text x="281" y="80" text-anchor="middle" class="diagram-small">HEAT FLOW</text><text x="384" y="185" class="diagram-label">DIE</text><text x="384" y="221" class="diagram-label">SUBSTRATE</text><text x="420" y="251" class="diagram-label">PCB</text>
            <path d="M183 282h194 M183 275v14 M377 275v14"/><text x="280" y="307" text-anchor="middle" class="diagram-small">INTERCONNECTION &amp; SUPPORT</text>
          </svg>
        )}
        <figcaption>{computing ? 'Simplified system architecture · conceptual, not to scale' : 'Simplified package cross-section · conceptual, not to scale'}</figcaption>
      </figure>
    </div>
  </section>
  <section id="explore" class="max-w-5xl mx-auto px-6 pb-20 scroll-mt-24">
    <div class="chapter-content prose prose-lg max-w-none dark:prose-invert prose-headings:text-heading prose-a:text-primary prose-a:underline-offset-4"><slot /></div>
  </section>
  <section class="max-w-7xl mx-auto px-6 pb-24"><div class="rounded-3xl bg-blue-50 dark:bg-slate-800 px-8 py-12 md:p-16 flex flex-wrap items-center justify-between gap-8"><div><p class="text-sm uppercase tracking-widest text-primary font-bold">Let's connect</p><h2 class="mt-3 text-3xl md:text-4xl font-bold text-heading">Interested in learning more?</h2><p class="mt-4 text-muted max-w-xl">Get in touch with our student branch to discuss your interests and find out how to get involved.</p></div><a href="/contact" class="rounded-full bg-primary px-7 py-4 text-white font-semibold hover:bg-secondary transition">Find our community →</a></div></section>
</Layout>
<style>
 .technical-figure{margin:0;padding:1.5rem;border:1px solid #cbdbe5;border-radius:1rem;background:#f5f9fb;color:#123a55}
 .technical-figure svg{width:100%;height:auto}.technical-figure rect,.technical-figure path{fill:none;stroke:#397397;stroke-width:1.5}.technical-figure circle{fill:#397397}.technical-figure text{fill:#173e57;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.technical-figure .diagram-kicker{font-size:10px;letter-spacing:1.3px;fill:#50738b}.technical-figure .diagram-label{font-size:11px;font-weight:700;letter-spacing:.5px}.technical-figure .diagram-small{font-size:10px;fill:#50738b}.technical-figure .layer-board{fill:#c8dfdd}.technical-figure .layer-substrate{fill:#c7d7e7}.technical-figure .layer-die{fill:#85b5cf}
 .technical-figure figcaption{margin-top:.5rem;color:#50738b;font-size:.75rem}
 .chapter-content :global(h2){margin-top:3rem;font-size:2rem;letter-spacing:-.025em}.chapter-content :global(h3){margin-top:1.7rem}.chapter-content :global(ul){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;list-style:none;padding:0}.chapter-content :global(li){margin:0;padding:1.25rem 1.5rem;border-radius:1rem;background:color-mix(in srgb,var(--aw-color-primary) 7%,transparent)}
 @media(max-width:640px){.chapter-content :global(ul){grid-template-columns:1fr}}
</style>
